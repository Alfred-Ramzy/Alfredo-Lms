rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function hasUserDoc(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function role() {
      return signedIn() && hasUserDoc(request.auth.uid)
        ? userDoc(request.auth.uid).data.role
        : null;
    }

    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    function isInstructor() {
      return signedIn() && role() == 'instructor';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function sameInstructor(courseId) {
      return signedIn()
        && exists(/databases/$(database)/documents/courses/$(courseId))
        && get(/databases/$(database)/documents/courses/$(courseId)).data.instructorId == request.auth.uid;
    }

    function isEnrolled(courseId) {
      return signedIn() && exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId));
    }

    function publishedCourse(courseId) {
      return exists(/databases/$(database)/documents/courses/$(courseId))
        && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published';
    }

    function validActivationEnrollment(codeId, courseId) {
      return signedIn()
        && existsAfter(/databases/$(database)/documents/activationCodes/$(codeId))
        && getAfter(/databases/$(database)/documents/activationCodes/$(codeId)).data.isUsed == true
        && getAfter(/databases/$(database)/documents/activationCodes/$(codeId)).data.usedBy == request.auth.uid
        && (
          !('courseId' in getAfter(/databases/$(database)/documents/activationCodes/$(codeId)).data)
          || getAfter(/databases/$(database)/documents/activationCodes/$(codeId)).data.courseId == courseId
        );
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == 'student';
      allow read: if isAdmin() || isOwner(userId);
      allow update: if isAdmin()
        || (isOwner(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role);
      allow delete: if false;
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if resource.data.status == 'published'
        || isAdmin()
        || (signedIn() && resource.data.instructorId == request.auth.uid);
      allow create: if isAdmin() || isInstructor();
      allow update: if isAdmin() || (isInstructor() && resource.data.instructorId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if isAdmin()
        || (isInstructor() && sameInstructor(resource.data.courseId))
        || (signedIn() && isEnrolled(resource.data.courseId))
        || (signedIn() && resource.data.isPreview == true && publishedCourse(resource.data.courseId));
      allow create: if isAdmin()
        || (isInstructor() && sameInstructor(request.resource.data.courseId));
      allow update: if isAdmin()
        || (isInstructor() && sameInstructor(resource.data.courseId));
      allow delete: if isAdmin()
        || (isInstructor() && sameInstructor(resource.data.courseId));
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.studentId == request.auth.uid)
        || (isInstructor() && resource.data.instructorId == request.auth.uid);
      allow create: if isAdmin()
        || (signedIn()
          && request.resource.data.studentId == request.auth.uid
          && enrollmentId == request.auth.uid + '_' + request.resource.data.courseId
          && validActivationEnrollment(request.resource.data.activationCodeId, request.resource.data.courseId));
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.studentId == request.auth.uid
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.instructorId == resource.data.instructorId
          && request.resource.data.courseId == resource.data.courseId
          && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    match /lessonProgress/{progressId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.studentId == request.auth.uid)
        || isInstructor();
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || isInstructor();

      match /questions/{questionId} {
        allow read: if signedIn();
        allow create, update, delete: if isAdmin() || isInstructor();
      }

      match /attempts/{attemptId} {
        allow read: if isAdmin() || isInstructor() || (signedIn() && resource.data.studentId == request.auth.uid);
        allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    match /assignments/{assignmentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || isInstructor();
    }

    match /submissions/{submissionId} {
      allow read: if isAdmin() || isInstructor() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAdmin() || isInstructor();
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /activationCodes/{codeId} {
      allow read: if isAdmin() || signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.isUsed == false
          && resource.data.isActive == true
          && request.resource.data.isUsed == true
          && request.resource.data.usedBy == request.auth.uid
          && request.resource.data.code == resource.data.code
          && request.resource.data.isActive == resource.data.isActive
          && request.resource.data.active == resource.data.active
          && request.resource.data.courseId == resource.data.courseId);
    }

    match /studentDevices/{deviceId} {
      allow read: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow create, update: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid);
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn();
      allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.participantIds);
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isAdmin() || (signedIn() && request.auth.uid in resource.data.participantIds);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds);
        allow create: if signedIn() && request.auth.uid == request.resource.data.senderId;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    match /discussions/{discussionId} {
      allow read: if true;
      allow create: if signedIn();
      allow update: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /certificates/{certificateId} {
      allow read: if true;
      allow create: if isAdmin() || isInstructor() || (signedIn() && request.resource.data.studentId == request.auth.uid);
      allow update, delete: if isAdmin() || isInstructor();
    }

    match /campaigns/{campaignId} {
      allow read, write: if isAdmin();
    }

    match /platformSettings/{key} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
