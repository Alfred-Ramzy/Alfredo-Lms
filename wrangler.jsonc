{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alfredo-lms-web",
  "compatibility_date": "2026-09-21",
  "routes": [
    { "pattern": "alfredoedu.com/*", "zone_name": "alfredoedu.com" },
    { "pattern": "www.alfredoedu.com/*", "zone_name": "alfredoedu.com" }
  ],
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  }
}
